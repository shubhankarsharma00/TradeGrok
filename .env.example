# Local-only configuration. Never paste tokens into chat or the browser.
PORT=3100
# Angel One hosted login, read-only account data and quotes for paper trading.
# Loopback callback is for development; Angel One registration requires public HTTPS.
# Replace with YOUR Azure App Service origin after setting up the relay.
# Leave blank to explore the dashboard without connecting an account.
SMARTAPI_RELAY_ORIGIN=
SMARTAPI_API_KEY=
