# Configure these nonsecret settings in your Azure App Service environment.
PUBLIC_ORIGIN=https://YOUR-APP.azurewebsites.net
LOCAL_RETURN_ORIGIN=http://127.0.0.1:3100
# Azure supplies PORT, WEBSITE_SITE_NAME and WEBSITE_HOSTNAME.
# Startup: node server/azure.js.
# Keep Easy Auth disabled: the relay and health response are anonymous.
# Do not put broker keys, tokens, .env files or local data in Azure or the ZIP.
# Disable URL/query/response-header logging and request telemetry before login.
